{
  "manifest_version": 3,
  "name": "Aistim Board",
  "version": "0.5.0",
  "description": "Dashboard sederhana di tab baru: jam, sapaan, kutipan, daftar tugas, dan pengaturan latar.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/devtim-lab/Aistim.board/*"
  ]
}